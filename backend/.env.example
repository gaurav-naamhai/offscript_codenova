# Inkloom AI / Offscript - Backend Configuration

# Frontend CORS origin (e.g. http://localhost:3000 or * for local dev)
FRONTEND_ORIGIN=http://localhost:3000

# Storage engine: "memory" (default thread-safe FIFO) or "supabase"
REPO_BACKEND=memory

# Google Gemini API Configuration (multimodal reasoning and verification)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Explicit Mock Mode for AI testing (true/false)
# Set to true during offline tests or when API keys are not available
# NEVER prints or leaks real keys.
MOCK_AI=false

# External Retrieval and Grounding (Ken's domain)
EXA_API_KEY=
TINYFISH_API_KEY=

# Supabase Storage & Database (Gaurav / Ken domain)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Demo Mode (enables POST /demo/seed for judging presentation)
DEMO_MODE=false

# External services disclosed in GET /disclosures (comma-separated, e.g. gemini,exa,tinyfish)
EXTERNAL_SERVICES_ENABLED=
